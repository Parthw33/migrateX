# =============================================================================
#  migrateX-UI — Environment Variables
#  Copy this file to .env and fill in values. Do not commit .env.
#
#  ⚠️  VITE_* variables are embedded in the client bundle — never use VITE_*
#      for secrets, tokens, or service keys.
# =============================================================================

# ── Node / build ──────────────────────────────────────────────────────────────
NODE_VERSION=20
PORT=3000

# ── AI — server-only ──────────────────────────────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Contentstack Management API — server-only ─────────────────────────────────
CONTENTSTACK_BASE_URL=https://api.contentstack.io
AUTH_TOKEN=
ORGANIZATION_UID=

# ── Contentstack Delivery / CDA (optional) ────────────────────────────────────
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=
# Region: us | eu | azure-na | azure-eu
CONTENTSTACK_REGION=
CONTENTSTACK_BRANCH=main

# ── GitHub — server-only ──────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=         # alternative name also supported
GITHUB_API_BASE=https://api.github.com

# ── MigrateX Backend API ──────────────────────────────────────────────────────
VITE_MIGRATEX_API_BASE_URL=

# ── Supabase (client-safe — anon key only) ────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (server-side) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Optional dev flags ────────────────────────────────────────────────────────
# VITE_DISABLE_PERSISTENCE=true
# VITE_LOG_LEVEL=debug
